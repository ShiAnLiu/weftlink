# Keep text files LF on every OS so generated-code checks are identical.
* text=auto eol=lf

# Binary assets must never be normalized.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary

# Windows-only helper scripts (if added) need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
